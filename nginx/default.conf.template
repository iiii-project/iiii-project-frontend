server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 壓縮傳輸：JS/CSS/wasm/manifest 這類文字型資產最吃這個，
    # 圖片/影片/字型已經是壓縮格式，本來就不列進 gzip_types。
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/wasm application/manifest+json image/svg+xml;

    # Vite 建置輸出的 /assets/ 檔名都帶 content hash，內容一變檔名就變，
    # 可以放心長快取＋immutable（瀏覽器不用重新驗證，直接用本地快取）。
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # public/ 底下這些是原始檔名、沒有 hash（Live2D wasm/模型、教學影片等），
    # 檔案本身可能會換內容但檔名不變，快取期短一點，到期後靠 ETag 驗證。
    location ~* \.(?:wasm|onnx|glb|mp4|mov|mp3|m4a|wav)$ {
        add_header Cache-Control "public, max-age=604800";
    }

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live2D 角色引擎（Django Channels），跟 /api 同一個後端，但需要 WebSocket 升級 header
    location /client-ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /live2d-models/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location /avatars/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location /bg/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location /cache/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
